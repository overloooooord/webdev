{
  "name": "ubisoft-ticket-manager",
  "version": "1.0.0",
  "description": "Ubisoft Support Ticket Manager with GUI",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "https-proxy-agent": "^9.1.0",
    "imap": "^0.8.19",
    "mailparser": "^3.9.14",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "puppeteer": "^25.3.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
